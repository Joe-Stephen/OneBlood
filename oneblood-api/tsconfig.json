{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@config":           ["src/config"],
      "@config/*":         ["src/config/*"],
      "@modules/*":        ["src/modules/*"],
      "@core/*":           ["src/core/*"],
      "@infrastructure/*": ["src/infrastructure/*"],
      "@middleware/*":     ["src/middleware/*"],
      "@shared/*":         ["src/shared/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
