# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-at-least-32-characters-long
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-characters-long
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3001

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# Production (Supabase): set DATABASE_URL only.
#   Get it from: Supabase Dashboard → Project Settings → Database
#   → Connection string → Session Pooler (port 5432)
# DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Local development: leave DATABASE_URL unset and fill in individual vars below.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oneblood
DB_USER=oneblood_app
DB_PASSWORD=oneblood_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Redis ─────────────────────────────────────────────────────────────────────
# Production (Upstash): set REDIS_URL only.
#   Get it from: Upstash Console → your database → "Redis URL" (rediss://…)
# REDIS_URL=rediss://default:<password>@<host>.upstash.io:6379

# Local development: leave REDIS_URL unset and fill in individual vars below.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/callback

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Email / OTP (Nodemailer) ──────────────────────────────────────────────────
# Gmail:    SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_PASS=<app-password>
# Mailtrap: SMTP_HOST=sandbox.smtp.mailtrap.io  SMTP_PORT=2525  (free dev inbox)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=noreply@oneblood.in

# ── Twilio SMS (stubbed — fill when ready) ────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Firebase FCM ──────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
